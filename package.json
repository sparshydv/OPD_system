{
  "name": "opd-token-allocation-engine",
  "version": "1.0.0",
  "description": "OPD Token Allocation Engine - Backend Service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --require tsconfig-paths/register src/index.ts",
    "watch": "tsc --watch",
    "dev:watch": "concurrently \"tsc --watch\" \"nodemon dist/index.js\"",
    "simulate": "ts-node --require tsconfig-paths/register src/simulation/runSimulation.ts",
    "simulate:detailed": "ts-node --require tsconfig-paths/register src/simulation/detailedSimulation.ts"
  },
  "keywords": [
    "opd",
    "token",
    "allocation",
    "engine"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.8",
    "concurrently": "^8.1.0",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
